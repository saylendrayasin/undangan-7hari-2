# ============================================================
#  Contoh environment variable
#  Salin file ini jadi .env.local untuk dipakai di komputer sendiri:
#
#     cp .env.example .env.local        (Mac / Linux / Git Bash)
#     copy .env.example .env.local      (Command Prompt Windows)
#
#  .env.local TIDAK ikut ter-commit ke Git (sudah masuk .gitignore),
#  jadi aman untuk menyimpan token asli di sana.
#
#  Di Vercel, isian ini TIDAK dibaca dari file. Tambahkan lewat
#  Settings > Environment Variables, lalu Redeploy.
# ============================================================


# ------------------------------------------------------------
#  1. TOKEN ADMIN  (untuk membuka /admin.html dan menghapus doa)
# ------------------------------------------------------------
#  Wajib diisi kalau ingin memakai halaman admin.
#  Pakai teks acak yang panjang — jangan tanggal lahir atau nama.
#
ADMIN_TOKEN=ganti-dengan-token-acak-yang-panjang


# ------------------------------------------------------------
#  2. DATABASE REDIS  (tempat menyimpan doa & ucapan)
# ------------------------------------------------------------
#  BOLEH DIKOSONGKAN saat mencoba di komputer sendiri.
#  `node dev-server.js` otomatis memakai database tiruan di memori,
#  jadi semua fitur tetap bisa dicoba tanpa internet.
#
#  Isi hanya kalau ingin menyambung ke database Upstash sungguhan.
#  Nilainya bisa dilihat di Vercel: Storage > (nama database) > .env.local
#
KV_REST_API_URL=
KV_REST_API_TOKEN=

#  Alternatif, kalau daftar langsung di upstash.com.
#  Cukup pakai SALAH SATU pasangan — tidak perlu keduanya.
#
# UPSTASH_REDIS_REST_URL=https://nama-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AX...


# ------------------------------------------------------------
#  Catatan
# ------------------------------------------------------------
#  - Jangan pakai tanda kutip. Tulis  ADMIN_TOKEN=abc123
#    bukan  ADMIN_TOKEN="abc123"
#  - Jangan ada spasi sebelum atau sesudah tanda '='
#  - Setelah mengubah file ini, jalankan ulang `node dev-server.js`
#  - Untuk mengecek mana yang sudah terbaca, buka /api/doa?diag=1
