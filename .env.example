# Disetel otomatis oleh integrasi Upstash di Vercel (Storage > Create Database).
# Cukup salin file ini jadi .env.local kalau mau menjalankan `vercel dev` dengan database.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternatif kalau daftar langsung di upstash.com:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opsional: mengaktifkan penghapusan doa lewat DELETE /api/doa
# ADMIN_TOKEN=
